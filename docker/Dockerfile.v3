# DGX Spark Qwen3.5-122B "v2 patches" ported to the modern vLLM base.
#
# This is the Step-4 thin layer from the drewid74 runbook, retargeted from
# vLLM 0.19.1 (vllm-sm121) to vLLM 0.26.1rc1 (vllm-node-20260730).
#
# It does NOT rebuild the SM121 base. VLLM_BASE is consumed read-only and the
# result is written to a new tag, so vllm-sm121, vllm-qwen35-v2:latest and
# vllm-qwen35-v2:frozen-20260807 are never modified.
#
# Build:
#   docker build -t vllm-qwen35-v3 -f docker/Dockerfile.v3 .
#
# Differences from albond's docker/Dockerfile.v2:
#
#   1. Patch 01 is applied by an anchored script instead of by overwriting
#      inc.py wholesale. Upstream split inc.py into an inc/ package, so a
#      drop-in file replacement would clobber the new config_parser/schemes
#      wiring. The script edits the package in place and exits non-zero if any
#      anchor has drifted.
#   2. Patch 03 targets the new LogitsProcessor._apply_head host site.
#   3. The starlette>=0.40,<1.0 downgrade is DROPPED. It existed because
#      transformers 5.x dragged in Starlette 1.x which broke vLLM 0.19's
#      router (_IncludedRouter.path). 0.26 runs on Starlette 1.3.1 natively
#      (verified: vllm.entrypoints.openai.api_server imports clean), so
#      re-pinning it here would reintroduce the incompatibility it once fixed.

ARG VLLM_BASE=vllm-node-20260730:latest
FROM ${VLLM_BASE}

# Patch 1: Hybrid INT4+FP8 dispatch for shared expert / linear_attn dense layers
COPY patches/01-hybrid-int4-fp8/patch_inc_hybrid.py /opt/patches/patch_inc_hybrid.py
RUN python3 /opt/patches/patch_inc_hybrid.py \
 && grep -q DGX_SPARK_HYBRID_INT4_FP8 \
      /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/inc/inc.py

# Patch 2: INT8 LM Head v2, baked in at build time so startup goes straight to serve
COPY patches/03-int8-lm-head/patch_int8_lmhead_v3.py /opt/patches/patch_int8_lmhead_v3.py
RUN python3 /opt/patches/patch_int8_lmhead_v3.py \
 && grep -q DGX_SPARK_INT8_LMHEAD_V2 \
      /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/logits_processor.py

# Patch 4: MTP/draft-head quant scoping. vLLM strips the "mtp." prefix when it
# builds the draft model, so the head's layers match no declared block, resolve
# as unquantized, and load dies on the checkpoint's packed .qweight. Not needed
# on 0.19, which scoped the lookup correctly.
COPY patches/04-mtp-block-scope/patch_mtp_block_scope.py /opt/patches/patch_mtp_block_scope.py
RUN python3 /opt/patches/patch_mtp_block_scope.py \
 && grep -q DGX_SPARK_MTP_BLOCK_SCOPE \
      /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/inc/config_parser.py

# Patch 5: propagate quantization_config to the Qwen3.5 MTP draft config. On
# this VL-wrapper checkpoint it lives on the outer config, so the draft model
# was being built with no quant method at all. Upstream already does this for
# step3p5 and minimax_m3_vl.
COPY patches/05-mtp-quant-config/patch_mtp_quant_config.py /opt/patches/patch_mtp_quant_config.py
RUN python3 /opt/patches/patch_mtp_quant_config.py \
 && grep -q DGX_SPARK_MTP_QUANT_CONFIG \
      /usr/local/lib/python3.12/dist-packages/vllm/config/speculative.py

# Patch 6: VLLM_MTP_TOP_K — let the MTP draft head route to more experts than
# the target model. The head reads the same global num_experts_per_tok, so
# cutting the target to top-k=4 cut the draft head with it. NOT an upstream
# vLLM variable: without this patch the env var is silently ignored. Inert
# unless VLLM_MTP_TOP_K is set to a positive value.
COPY patches/06-mtp-top-k/patch_mtp_top_k.py /opt/patches/patch_mtp_top_k.py
RUN python3 /opt/patches/patch_mtp_top_k.py \
 && grep -q DGX_SPARK_MTP_TOP_K \
      /usr/local/lib/python3.12/dist-packages/vllm/model_executor/models/qwen3_5_mtp.py

# Fail the build rather than ship an image whose vLLM does not import.
RUN python3 -c "import vllm.entrypoints.openai.api_server; print('v3 patched image: imports OK')"

# Keep the base entrypoint (nvidia_entrypoint.sh); it execs whatever it is given.
CMD ["vllm", "serve", "--help"]
